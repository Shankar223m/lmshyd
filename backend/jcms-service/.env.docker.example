# jcms-service: docker compose settings (CursorJobs backend under LMS)
# Copy to .env.docker and edit; never commit real secrets.

APP_NAME=JCMS
APP_ENV=local
DEBUG=false
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lms_jcms
DATABASE_URL=postgresql+psycopg://lms:lms@postgres:5432/lms_jcms

REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage

CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4

FRONTEND_URL=http://localhost:3000

LMS_AUTH_ENABLED=true
LMS_JWKS_URL=http://user-management:8000/.well-known/jwks.json
LMS_USER_MANAGEMENT_URL=http://user-management:8000
LMS_JWT_ISSUER=lms-user-management
LMS_JWT_AUDIENCE=lms
LMS_JWKS_CACHE_SECONDS=300
LMS_JWKS_TIMEOUT_SECONDS=5.0

SMTP_ENABLED=false
SMTP_FROM_EMAIL=noreply@jcms.local

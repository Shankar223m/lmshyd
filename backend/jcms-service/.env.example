# Application
APP_NAME=JCMS
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL in Docker Compose mapped to host 5433)
POSTGRES_USER=jcms
POSTGRES_PASSWORD=jcms
POSTGRES_DB=jcms
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://jcms:jcms@localhost:5433/jcms

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File storage (local dev)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Frontend URL (links in emails)
FRONTEND_URL=http://localhost:5173

# LMS authentication bridge (JWKS). When enabled, JCMS login/register are disabled.
LMS_AUTH_ENABLED=true
LMS_JWKS_URL=http://localhost:8001/.well-known/jwks.json
LMS_USER_MANAGEMENT_URL=http://localhost:8001
LMS_JWT_ISSUER=lms-user-management
LMS_JWT_AUDIENCE=lms
LMS_JWKS_CACHE_SECONDS=300
LMS_JWKS_TIMEOUT_SECONDS=5.0

# Email (optional — set SMTP_ENABLED=true in production)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@jcms.local
SMTP_USE_TLS=true
